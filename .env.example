MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# If you see "queryTxt ETIMEOUT", use Atlas → Connect → Drivers → "Standard connection string"
# (mongodb://... not mongodb+srv://) — it avoids SRV/TXT DNS lookups on restrictive networks.
MONGODB_DB_NAME=building_sentence_app
